<ctrl:FrostyWindow
    x:Class="AssetBankPlugin.Windows.TreePreviewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:Frosty.Controls;assembly=FrostyControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    Title="Ant Asset Tree" Height="720" Width="1280"
    Background="#1E1E1E" Foreground="White"
    Icon="/FrostyCore;component/AppIcon.ico"
    ResizeMode="CanResizeWithGrip">

    <ctrl:FrostyWindow.Resources>

        <Style x:Key="TreeFlatBtn" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#D0D0D0"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#555555"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1C1C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TreeModeBtn" TargetType="RadioButton">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#A0A0A0"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1C3852"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="#44AAFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </ctrl:FrostyWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#252526"
                BorderBrush="#111" BorderThickness="0,0,0,1">
            <Grid Margin="10,0">

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="PART_RootLabel"
                               Foreground="White" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextOptions.TextFormattingMode="Display"/>
                    <Border Width="1" Height="14" Background="#3F3F46" Margin="8,0"/>
                    <TextBlock x:Name="PART_TypeLabel"
                               Foreground="#007ACC" FontSize="11"
                               VerticalAlignment="Center"
                               TextOptions.TextFormattingMode="Display"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">

                    <Border x:Name="PART_DepthPanel" Visibility="Visible"
                            Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1"
                            CornerRadius="3" Margin="0,0,8,0" Padding="8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Fwd:" Foreground="#A0A0A0" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,5,0"
                                       TextOptions.TextFormattingMode="Display"/>
                            <TextBox x:Name="PART_ForwardDepth" Text="3" Width="34"
                                     Background="#1A1A1A" Foreground="White"
                                     BorderBrush="#555" BorderThickness="1"
                                     CaretBrush="White" SelectionBrush="#007ACC"
                                     FontSize="11" Padding="3,1" VerticalContentAlignment="Center"
                                     TextOptions.TextFormattingMode="Display"/>
                            <TextBlock Text="Bwd:" Foreground="#A0A0A0" FontSize="11"
                                       VerticalAlignment="Center" Margin="8,0,5,0"
                                       TextOptions.TextFormattingMode="Display"/>
                            <TextBox x:Name="PART_BackwardDepth" Text="3" Width="34"
                                     Background="#1A1A1A" Foreground="White"
                                     BorderBrush="#555" BorderThickness="1"
                                     CaretBrush="White" SelectionBrush="#007ACC"
                                     FontSize="11" Padding="3,1" VerticalContentAlignment="Center"
                                     TextOptions.TextFormattingMode="Display"/>
                            <Button x:Name="PART_ApplyDepthBtn" Content="OK"
                                    Padding="14,0" Height="20" Margin="8,0,0,0"
                                    Style="{StaticResource TreeFlatBtn}"/>
                        </StackPanel>
                    </Border>

                    <RadioButton x:Name="PART_LocalBtn" Content="Local"
                                 GroupName="ViewMode" IsChecked="False"
                                 Style="{StaticResource TreeModeBtn}"
                                 Margin="0,0,2,0"/>
                    <RadioButton x:Name="PART_GlobalBtn" Content="Global"
                                 GroupName="ViewMode" IsChecked="True"
                                 Style="{StaticResource TreeModeBtn}"
                                 Margin="0,0,10,0"/>

                    <Button x:Name="PART_OrganiseBtn" Content="Organise"
                            Style="{StaticResource TreeFlatBtn}" Margin="0,0,4,0"/>
                    <Button x:Name="PART_FitBtn" Content="Fit View"
                            Style="{StaticResource TreeFlatBtn}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#2D2D30"
                BorderBrush="#111" BorderThickness="0,0,0,1">
            <TextBlock Margin="10,0" VerticalAlignment="Center"
                       Foreground="#ABABAB" FontSize="11"
                       TextOptions.TextFormattingMode="Display"
                       Text="Scroll: zoom   |   Right-drag: pan   |   Left-drag: move node   |   Double-click: open in editor   |   Right-click node: copy GUID"/>
        </Border>

        <Grid Grid.Row="2">

            <Border x:Name="PART_CanvasHost"
                    Background="#1A1A1C" ClipToBounds="True">
                <Canvas x:Name="PART_Canvas" Background="Transparent"
                        HorizontalAlignment="Left" VerticalAlignment="Top"/>
            </Border>

            <Border x:Name="PART_LoadingOverlay" Visibility="Collapsed"
                    Background="#CC1A1A1C">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="PART_LoadingText"
                               Foreground="White" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               TextOptions.TextFormattingMode="Display"
                               Text="Building graph..."/>
                    <TextBlock Foreground="#666666" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,8,0,0"
                               TextOptions.TextFormattingMode="Display"
                               Text="Scanning asset references"/>
                </StackPanel>
            </Border>

        </Grid>

    </Grid>

</ctrl:FrostyWindow>
